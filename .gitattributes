# Normalize line endings so Windows and macOS teammates don't produce noisy diffs.
# Text files are stored with LF in the repo and checked out with LF.
* text=auto eol=lf

# Windows-specific files keep CRLF
*.sln  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary files — never touch line endings or try to diff
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.webp     binary
*.ico      binary
*.icns     binary
*.ttf      binary
*.otf      binary
*.woff     binary
*.woff2    binary
*.mp3      binary
*.mp4      binary
*.pdf      binary
*.zip      binary
*.jar      binary
*.keystore binary
*.dll      binary
*.exe      binary
