# Copy this file to `.env` and adjust for your machine. `.env` is git-ignored.
# Variables prefixed with EXPO_PUBLIC_ are inlined into the JS bundle, so NEVER put secrets here.

# Base URL of the MS-Companion API (no trailing slash).
#   - Web / iOS simulator:   http://localhost:<port>
#   - Android emulator:      http://10.0.2.2:<port>
#   - Physical phone (Expo Go): http://<your-PC-LAN-IP>:<port>   e.g. http://192.168.1.20:5080
# The API's http port is 5080 (code/ms-companion-api/MSCompanion/MSCompanion.Api/Properties/launchSettings.json).
EXPO_PUBLIC_API_URL=http://localhost:5080
