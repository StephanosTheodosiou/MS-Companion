# Send these requests from VS Code (REST Client extension), Visual Studio or Rider.
@baseUrl = http://localhost:5080

### Health check (API + database)
GET {{baseUrl}}/health

### Register a new account
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "jane@example.com",
  "password": "ChangeMe123!",
  "firstName": "Jane",
  "lastName": "Doe"
}

### Sign in
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "jane@example.com",
  "password": "ChangeMe123!"
}

### Sign in with "remember me" (the response also contains a refreshToken)
# @name loginRemember
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "jane@example.com",
  "password": "ChangeMe123!",
  "rememberMe": true
}

### Get a new token pair (each refresh token works once; keep the newest)
POST {{baseUrl}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{loginRemember.response.body.$.refreshToken}}"
}

### Sign out (the token and its refresh token stop working immediately)
POST {{baseUrl}}/api/auth/logout
Authorization: Bearer {{login.response.body.$.token}}

### Current user (uses the token from the "login" request above)
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{login.response.body.$.token}}

### My patient profile (created empty at registration)
GET {{baseUrl}}/api/patient/me
Authorization: Bearer {{login.response.body.$.token}}

### Update my patient profile (PUT: fields left out are cleared; only timeZone is required)
PUT {{baseUrl}}/api/patient/me
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "preferredName": "Jane",
  "dateOfBirth": "1988-04-12",
  "msType": "RelapsingRemitting",
  "diagnosisYear": 2019,
  "msTeamName": "Nicosia General MS Clinic",
  "msTeamPhone": "+357 22 000000",
  "timeZone": "Europe/Nicosia"
}

### My consent choices (one entry per data type; never decided = not granted)
GET {{baseUrl}}/api/consent
Authorization: Bearer {{login.response.body.$.token}}

### Record consent (e.g. the onboarding screen). Unchanged choices are skipped.
POST {{baseUrl}}/api/consent
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "policyVersion": "2026-11-v1",
  "decisions": [
    { "dataType": "SymptomCheckins", "granted": true },
    { "dataType": "Medication", "granted": true },
    { "dataType": "Reminders", "granted": true },
    { "dataType": "Location", "granted": false }
  ]
}

### Consent history (every decision, newest first)
GET {{baseUrl}}/api/consent/history
Authorization: Bearer {{login.response.body.$.token}}

### My medications (needs Medication consent for changes)
GET {{baseUrl}}/api/medications
Authorization: Bearer {{login.response.body.$.token}}

### Add a medication
# @name addMedication
POST {{baseUrl}}/api/medications
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "name": "Dimethyl fumarate",
  "dose": "240 mg",
  "instructions": "Take with food",
  "isDiseaseModifying": true,
  "startDate": "2026-06-01"
}

### Add a reminder time
# @name addSchedule
POST {{baseUrl}}/api/medications/{{addMedication.response.body.$.id}}/schedules
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "timeOfDay": "08:00",
  "days": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
}

### Log a dose for that reminder
POST {{baseUrl}}/api/medications/{{addMedication.response.body.$.id}}/intakes
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "scheduleId": "{{addSchedule.response.body.$.schedules[0].id}}",
  "scheduledFor": "2026-11-23T08:00:00+02:00",
  "status": "Taken"
}

### Dose history
GET {{baseUrl}}/api/medications/intakes?from=2026-11-01T00:00:00Z&to=2026-12-01T00:00:00Z
Authorization: Bearer {{login.response.body.$.token}}

### Relapse log (US-01)
GET {{baseUrl}}/api/relapse-log
Authorization: Bearer {{login.response.body.$.token}}

### Log a new or worsening symptom (guidance must match the answers)
POST {{baseUrl}}/api/relapse-log
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "symptomDescription": "Numbness in left leg",
  "bodyArea": "Left leg",
  "onsetDate": "2026-11-20",
  "lastedOver24Hours": true,
  "hadFever": false,
  "heatExposure": false,
  "guidanceShown": "ContactMsTeamToday",
  "contactedMsTeam": false
}

### Sync: upload rows saved offline (ids come from the phone)
POST {{baseUrl}}/api/sync/push
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "checkIns": [
    {
      "id": "0193a1b2-0000-7000-8000-0000000000c1",
      "localDate": "2026-11-21",
      "timeZone": "Europe/Nicosia",
      "questionnaireVersion": "2",
      "note": "Tired after work",
      "answers": [
        { "item": "Fatigue", "score": 7 },
        { "item": "Mobility", "score": 3 },
        { "item": "Pain", "score": 2 },
        { "item": "Mood", "score": 4 },
        { "item": "Cognition", "score": 3 },
        { "item": "Bladder", "score": 1 }
      ],
      "createdAt": "2026-11-21T08:00:00Z",
      "updatedAt": "2026-11-21T08:00:00Z"
    }
  ],
  "relapseLogEntries": [
    {
      "id": "0193a1b2-0000-7000-8000-000000000001",
      "symptomDescription": "Numbness in left leg",
      "onsetDate": "2026-11-20",
      "lastedOver24Hours": true,
      "hadFever": false,
      "heatExposure": false,
      "guidanceShown": "ContactMsTeamToday",
      "createdAt": "2026-11-21T09:00:00Z",
      "updatedAt": "2026-11-21T09:00:00Z"
    }
  ]
}

### Sync: download changes (send back the cursor from the previous pull)
GET {{baseUrl}}/api/sync/pull
Authorization: Bearer {{login.response.body.$.token}}

### Appointments
GET {{baseUrl}}/api/appointments?from=2026-11-01T00:00:00Z&to=2027-01-01T00:00:00Z
Authorization: Bearer {{login.response.body.$.token}}

### Next visit: Booked appointments from now on (status can repeat: ?status=Booked&status=Cancelled)
GET {{baseUrl}}/api/appointments?status=Booked&from=2026-11-23T00:00:00Z
Authorization: Bearer {{login.response.body.$.token}}

### Add an appointment (endsAt is required unless status is Cancelled)
POST {{baseUrl}}/api/appointments
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "startsAt": "2026-12-10T10:30:00+02:00",
  "endsAt": "2026-12-10T11:00:00+02:00",
  "type": "Neurologist",
  "clinicianName": "Dr. Georgiou",
  "location": "Nicosia General Hospital"
}

### Questions for my doctor (status=open or asked, optional appointmentId)
GET {{baseUrl}}/api/visit-questions?status=open
Authorization: Bearer {{login.response.body.$.token}}

### Add a question
POST {{baseUrl}}/api/visit-questions
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "text": "Could the tiredness in the afternoons be from the new medication?"
}

### Side effects (ongoing=true for current ones, optional medicationId)
GET {{baseUrl}}/api/side-effects?ongoing=true
Authorization: Bearer {{login.response.body.$.token}}

### Report a side effect (medicationId is optional; needs Medication consent)
POST {{baseUrl}}/api/side-effects
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "description": "Flushing and warm face after the morning dose",
  "severity": "Mild",
  "startedOn": "2026-11-18"
}

### Blood tests (status=Upcoming, Overdue or Completed; optional medicationId)
GET {{baseUrl}}/api/blood-tests?status=Upcoming
Authorization: Bearer {{login.response.body.$.token}}

### Add a blood test reminder (needs Medication consent)
# @name addBloodTest
POST {{baseUrl}}/api/blood-tests
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "testName": "Full blood count",
  "dueDate": "2026-12-01",
  "repeatEveryWeeks": 12
}

### Mark it done (creates the next one when it repeats)
POST {{baseUrl}}/api/blood-tests/{{addBloodTest.response.body.$.id}}/complete
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "completedOn": "2026-11-24"
}
