# https://editorconfig.org — consistent formatting across VS Code, Visual Studio and Rider
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csx}]
indent_size = 4

[*.sln]
indent_style = tab
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
